<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KinokoTAS.App" x:Class="KinokoTAS.App.MainWindow" Title="Kinoko TAS" Width="1500" Height="1050" MinWidth="1000" MinHeight="720" Background="#10151F">
<Grid RowDefinitions="Auto,*,Auto">
 <Border Padding="20,14" Background="#171F2D"><StackPanel Spacing="8">
  <WrapPanel Orientation="Horizontal"><TextBlock Text="KINOKO / TAS" FontSize="23" Foreground="#77DBC7" VerticalAlignment="Center" Margin="0,0,24,0"/><Button Content="新建录制" Click="NewRecordingClick" Margin="0,0,8,0"/><Button Content="打开录制" Click="OpenClick" Margin="0,0,8,0"/><Button Content="保存录制…" Click="SaveRecordingClick" Margin="0,0,16,0"/><TextBlock x:Name="EngineLabel" Text="尚未开始" Foreground="#E9BA71" VerticalAlignment="Center"/></WrapPanel>
  <TextBlock x:Name="GamePathLabel" Foreground="#A6B5C8" TextWrapping="Wrap" FontSize="12"/>
  <Expander Header="设置与项目文件"><WrapPanel><Button Content="更换游戏程序" Click="ChangeGameClick" Margin="0,0,12,0"/><CheckBox x:Name="EmbeddedOption" Content="内嵌预览（下次启动生效）" IsChecked="False" Margin="0,0,20,0"/><Button x:Name="SaveButton" Content="另存输入草稿项目…" Click="SaveClick" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="仅导出原始录制…" Click="ExportClick" IsEnabled="False"/></WrapPanel></Expander>
 </StackPanel></Border>
 <Grid Grid.Row="1" RowDefinitions="3*,6,2*" ColumnDefinitions="*,300" Margin="20,12" ColumnSpacing="16">
  <Border Background="#070B10" CornerRadius="8" Margin="0,0,0,8"><Grid RowDefinitions="Auto,*,Auto">
   <WrapPanel Margin="10"><TextBlock Text="播放控制" VerticalAlignment="Center" Foreground="#A6B5C8" Margin="0,0,14,0"/><Button Content="播放" Click="PlayGameClick" Margin="0,0,6,0"/><Button Content="暂停" Click="PauseGameClick" Margin="0,0,6,0"/><Button Content="前进一帧" Click="StepGameClick" Margin="0,0,6,0"/><Button Content="从这里继续录制" Click="TakeoverClick"/></WrapPanel>
   <Border x:Name="GamePanel" Grid.Row="1" Focusable="True" KeyDown="GameKeyDown" KeyUp="GameKeyUp" LostFocus="GameLostFocus" PointerPressed="GamePointerPressed"><Grid><TextBlock x:Name="ExternalHint" Text="游戏将在独立窗口显示&#10;&#10;从顶部新建或打开录制&#10;F9 播放 / 暂停 · F10 前进一帧" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A6B5C8" FontSize="18" TextAlignment="Center"/><Image x:Name="GameImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/></Grid></Border>
   <TextBlock x:Name="GameStatus" Grid.Row="2" Margin="10,6" Foreground="#A6B5C8" Text="准备就绪。首次开始时选择游戏程序，之后自动使用。" TextWrapping="Wrap"/>
  </Grid></Border>
  <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#2C3749" ResizeDirection="Rows"/>
  <Border Grid.Row="2" Background="#151D29" CornerRadius="8"><Grid RowDefinitions="Auto,*,Auto">
   <TextBlock x:Name="DocumentLabel" Margin="12,10" Text="时间轴 · 尚未打开录制" Foreground="#BBC7D8"/>
   <Grid Grid.Row="1" ColumnDefinitions="*,18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><local:TimelineControl x:Name="Timeline" Width="1315" VerticalAlignment="Stretch"/></ScrollViewer><ScrollBar x:Name="FrameScroll" Grid.Column="1" Orientation="Vertical" ValueChanged="ScrollChanged"/></Grid>
   <WrapPanel Grid.Row="2" Margin="12"><TextBlock Text="定位帧" VerticalAlignment="Center" Foreground="#A6B5C8" Margin="0,0,12,0"/><Button Content="上一帧" Click="PreviousClick" Margin="0,0,6,0"/><Button Content="下一帧" Click="NextClick" Margin="0,0,6,0"/><NumericUpDown x:Name="JumpFrame" Width="135" Minimum="0" Maximum="0" FormatString="0" Value="0" Margin="0,0,6,0"/><Button Content="跳到此帧" Click="JumpClick"/></WrapPanel>
  </Grid></Border>
  <ScrollViewer Grid.Column="1" Grid.RowSpan="3"><StackPanel Spacing="12">
   <Border Background="#192332" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="帧工具" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FrameLabel" Text="—" FontSize="30"/><TextBlock x:Name="FrameDetails" Text="尚未载入录制" TextWrapping="Wrap" Foreground="#A6B5C8" FontSize="12"/>
    <TextBlock Text="书签 / 重点" FontSize="16" Margin="0,8,0,0"/><TextBox x:Name="BookmarkName" PlaceholderText="名称，例如：Boss 前"/><Button Content="标记当前帧" Click="AddBookmarkClick" HorizontalAlignment="Stretch"/><ListBox x:Name="BookmarkList" MinHeight="75" MaxHeight="180"/><WrapPanel><Button Content="返回选中书签" Click="ReturnBookmarkClick" Margin="0,0,6,0"/><Button Content="删除" Click="RemoveBookmarkClick"/></WrapPanel><TextBlock Text="返回时自动重播定位；录制中返回会先保留当前录制。不是瞬时快照。" TextWrapping="Wrap" Foreground="#A6B5C8" FontSize="12"/>
   </StackPanel></Border>
   <Expander Header="编辑帧输入（草稿）"><Border Background="#192332" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="修改尚不影响游戏回放；可另存项目。" TextWrapping="Wrap" Foreground="#E9BA71"/><WrapPanel><Button x:Name="UndoButton" Content="撤销" Click="UndoClick" IsEnabled="False" Margin="0,0,8,0"/><Button x:Name="RedoButton" Content="重做" Click="RedoClick" IsEnabled="False"/></WrapPanel><TextBlock Text="起始帧 / 结束帧（含两端）" Foreground="#A6B5C8"/><NumericUpDown x:Name="RangeStart" Minimum="0" Maximum="0" Value="0" FormatString="0"/><NumericUpDown x:Name="RangeEnd" Minimum="0" Maximum="0" Value="0" FormatString="0"/><ComboBox x:Name="ActionPicker" HorizontalAlignment="Stretch" SelectedIndex="4"/><Button x:Name="HoldButton" Content="整个区间按住" Click="HoldClick" IsEnabled="False"/><Button x:Name="ReleaseButton" Content="整个区间松开" Click="ReleaseClick" IsEnabled="False"/></StackPanel></Border></Expander>
   <TextBlock x:Name="ValidationLabel" Text="输入格是编辑草稿；实际操作由游戏录制。" TextWrapping="Wrap" Foreground="#D0C4AE" FontSize="12"/>
  </StackPanel></ScrollViewer>
 </Grid>
 <Border Grid.Row="2" Background="#171F2D" Padding="20,10"><StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SavedPathLabel" Text="保存位置：尚未保存；点击顶部“保存录制…”选择目录" Foreground="#77DBC7" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="OpenSavedButton" Grid.Column="1" Content="打开保存目录" Click="OpenSavedClick" IsEnabled="False" Margin="12,0,0,0"/></Grid><TextBlock x:Name="StatusLabel" Text="Ctrl+O 打开 · Ctrl+S 保存录制" Foreground="#A6B5C8" TextWrapping="Wrap"/></StackPanel></Border>
</Grid></Window>
