<Window
    x:Class="KinokoTAS.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:local="using:KinokoTAS.App"
    Title="6kinoko TAS"
    Width="1500"
    Height="1050"
    MinWidth="1000"
    MinHeight="720"
    Background="#10151F"
    Icon="/Assets/6kinoko.ico">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="20,14" Background="#171F2D">
            <StackPanel Spacing="8">
                <CommandBar x:Name="FileCommands" DefaultLabelPosition="Right">
                    <CommandBar.Content>
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                            <TextBlock
                                x:Name="GamePathLabel"
                                MaxWidth="500"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#A6B5C8"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </CommandBar.Content>
                    <CommandBar.PrimaryCommands>
                        <CommandBarButton Click="NewRecordingClick" Label="新建录制">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="DocumentAdd" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton
                            Click="OpenClick"
                            Label="打开录制"
                            ToolTip.Tip="打开录制（Ctrl+O）">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="FolderOpen" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton
                            x:Name="SaveRecordingButton"
                            Click="SaveRecordingClick"
                            Label="保存录制"
                            ToolTip.Tip="保存 .krec；有编辑时先应用并验证（Ctrl+S）">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="Save" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                    </CommandBar.PrimaryCommands>
                    <CommandBar.SecondaryCommands>
                        <CommandBarButton
                            x:Name="ExportVideoButton"
                            Click="ExportVideoClick"
                            Label="导出视频…"
                            ToolTip.Tip="将已保存的录制导出为无声 MP4">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="ArrowExport" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton
                            Click="SaveRecordingAsClick"
                            Label="另存为录制…"
                            ToolTip.Tip="另存为录制（Ctrl+Shift+S）">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="Save" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarToggleButton
                            x:Name="EmbeddedOption"
                            IsChecked="False"
                            Label="内嵌预览">
                            <CommandBarToggleButton.Icon>
                                <icons:SymbolIcon Symbol="Window" />
                            </CommandBarToggleButton.Icon>
                        </CommandBarToggleButton>
                        <CommandBarButton Click="ChangeGameClick" Label="更换游戏程序…">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="Settings" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton
                            x:Name="SaveButton"
                            Click="SaveClick"
                            IsEnabled="False"
                            Label="高级：导出编辑草稿（.ktas）…"
                            ToolTip.Tip="仅备份待应用的编辑，不替代保存 .krec">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="DocumentSave" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                        <CommandBarButton
                            x:Name="ExportButton"
                            Click="ExportClick"
                            IsEnabled="False"
                            Label="高级：导出原始录制…">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="ArrowExport" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </StackPanel>
        </Border>
        <Grid
            Grid.Row="1"
            Margin="20,12"
            ColumnDefinitions="*,300"
            ColumnSpacing="16"
            RowDefinitions="2*,6,3*">
            <Border
                Margin="0,0,0,8"
                Background="#070B10"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,*,Auto">
                    <CommandBar Margin="8" DefaultLabelPosition="Right">
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock
                                    x:Name="EngineLabel"
                                    VerticalAlignment="Center"
                                    Foreground="#E9BA71"
                                    Text="播放控制 · 尚未开始" />
                                <ComboBox
                                    x:Name="SpeedPicker"
                                    Width="88"
                                    SelectedIndex="3"
                                    SelectionChanged="SpeedChanged"
                                    ToolTip.Tip="播放 / 录制速度">
                                    <ComboBoxItem Content="0.25×" />
                                    <ComboBoxItem Content="0.5×" />
                                    <ComboBoxItem Content="0.75×" />
                                    <ComboBoxItem Content="1×" />
                                    <ComboBoxItem Content="2×" />
                                    <ComboBoxItem Content="4×" />
                                </ComboBox>
                            </StackPanel>
                        </CommandBar.Content>
                        <CommandBar.PrimaryCommands>
                            <CommandBarButton
                                x:Name="PlayGameButton"
                                Click="PlayGameClick"
                                IsEnabled="False"
                                Label="播放"
                                ToolTip.Tip="播放 / 暂停（F9）">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="Play" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                x:Name="PauseGameButton"
                                Click="PauseGameClick"
                                IsVisible="False"
                                Label="暂停"
                                ToolTip.Tip="播放 / 暂停（F9）">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="Pause" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                Click="StepGameClick"
                                Label="前进一帧"
                                ToolTip.Tip="前进一帧（F10）">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="Next" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarToggleButton
                                x:Name="RecordToggle"
                                Click="TakeoverClick"
                                Label="录制"
                                ToolTip.Tip="切换录制（F8）">
                                <CommandBarToggleButton.Icon>
                                    <icons:SymbolIcon Symbol="Record" />
                                </CommandBarToggleButton.Icon>
                            </CommandBarToggleButton>
                            <CommandBarButton
                                x:Name="RestartGameButton"
                                Click="RestartGameClick"
                                IsEnabled="False"
                                Label="重新启动游戏">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="ArrowSync" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton Click="ReplayAllClick" Label="从头重播">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="ArrowCounterclockwise" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarToggleButton
                                x:Name="FollowLatest"
                                IsChecked="True"
                                Label="跟随最新帧">
                                <CommandBarToggleButton.Icon>
                                    <icons:SymbolIcon Symbol="ArrowRight" />
                                </CommandBarToggleButton.Icon>
                            </CommandBarToggleButton>
                        </CommandBar.PrimaryCommands>
                        <CommandBar.SecondaryCommands>
                            <CommandBarButton
                                x:Name="RestoreOverwriteButton"
                                Click="RestoreOverwriteClick"
                                IsEnabled="False"
                                Label="恢复上次覆盖"
                                ToolTip.Tip="Ctrl+Shift+Z">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="ArrowUndo" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                x:Name="CancelOperationButton"
                                Click="CancelOperationClick"
                                IsEnabled="False"
                                Label="取消定位 / 模拟"
                                ToolTip.Tip="Esc">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="Dismiss" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <Border
                        x:Name="GamePanel"
                        Grid.Row="1"
                        Focusable="True"
                        KeyDown="GameKeyDown"
                        KeyUp="GameKeyUp"
                        LostFocus="GameLostFocus"
                        PointerPressed="GamePointerPressed">
                        <Grid>
                            <TextBlock
                                x:Name="ExternalHint"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="#A6B5C8"
                                Text="游戏将在独立窗口显示&#10;&#10;从顶部新建或打开录制&#10;F8 切换录制 · F9 播放 / 暂停 · F10 前进一帧"
                                TextAlignment="Center" />
                            <Image
                                x:Name="GameImage"
                                RenderOptions.BitmapInterpolationMode="None"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <TextBlock
                        x:Name="GameStatus"
                        Grid.Row="2"
                        Margin="10,6"
                        Foreground="#A6B5C8"
                        Text="准备就绪。首次开始时选择游戏程序，之后自动使用。"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
            <GridSplitter
                Grid.Row="1"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                Background="#2C3749"
                ResizeDirection="Rows" />
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Background="#151D29"
                CornerRadius="8">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <CommandBar
                        x:Name="TimelineCommands"
                        Margin="8,4"
                        DefaultLabelPosition="Right">
                        <CommandBar.Content>
                            <TextBlock
                                x:Name="DocumentLabel"
                                MaxWidth="240"
                                VerticalAlignment="Center"
                                Foreground="#BBC7D8"
                                Text="时间轴 · 尚未打开录制"
                                TextTrimming="CharacterEllipsis" />
                        </CommandBar.Content>
                        <CommandBar.PrimaryCommands>
                            <CommandBarButton
                                x:Name="ApplyEditsButton"
                                Click="ApplyEditsClick"
                                IsEnabled="False"
                                Label="应用到录制"
                                ToolTip.Tip="应用并验证时间轴编辑，不写入保存文件（F5）；保存请用 Ctrl+S">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="Play" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                x:Name="UndoButton"
                                Click="UndoClick"
                                IsEnabled="False"
                                Label="撤销"
                                ToolTip.Tip="撤销输入编辑（Ctrl+Z）">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="ArrowUndo" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                            <CommandBarButton
                                x:Name="RedoButton"
                                Click="RedoClick"
                                IsEnabled="False"
                                Label="重做"
                                ToolTip.Tip="重做输入编辑（Ctrl+Y）">
                                <CommandBarButton.Icon>
                                    <icons:SymbolIcon Symbol="ArrowRedo" />
                                </CommandBarButton.Icon>
                            </CommandBarButton>
                        </CommandBar.PrimaryCommands>
                    </CommandBar>
                    <TextBlock
                        x:Name="EditWorkflowLabel"
                        Grid.Row="1"
                        Margin="12,0,12,8"
                        Foreground="#E9BA71"
                        Text="点击输入格编辑；F5 应用到录制，Ctrl+S 保存 .krec"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="2" RowDefinitions="*,16">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <local:TimelineControl
                                x:Name="Timeline"
                                Height="346"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top" />
                        </ScrollViewer>
                        <ScrollBar
                            x:Name="FrameScroll"
                            Grid.Row="1"
                            Orientation="Horizontal"
                            ValueChanged="ScrollChanged" />
                    </Grid>
                    <WrapPanel Grid.Row="3" Margin="12">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="#A6B5C8"
                            Text="定位帧" />
                        <Button
                            Margin="0,0,6,0"
                            Click="PreviousClick"
                            Content="上一帧" />
                        <Button
                            Margin="0,0,6,0"
                            Click="NextClick"
                            Content="下一帧" />
                        <NumericUpDown
                            x:Name="JumpFrame"
                            Width="135"
                            Margin="0,0,6,0"
                            FormatString="0"
                            Maximum="0"
                            Minimum="0"
                            Value="0" />
                        <Button Click="JumpClick" Content="跳到此帧" />
                    </WrapPanel>
                </Grid>
            </Border>
            <ScrollViewer
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1">
                <StackPanel Spacing="12">
                    <Border
                        Padding="16"
                        Background="#192332"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="帧工具" />
                            <TextBlock
                                x:Name="FrameLabel"
                                FontSize="30"
                                Text="—" />
                            <TextBlock
                                x:Name="FrameDetails"
                                FontSize="12"
                                Foreground="#A6B5C8"
                                Text="尚未载入录制"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="16"
                                Text="书签 / 重点" />
                            <TextBox x:Name="BookmarkName" PlaceholderText="名称，例如：Boss 前" />
                            <CommandBar DefaultLabelPosition="Right">
                                <CommandBar.PrimaryCommands>
                                    <CommandBarButton
                                        Click="AddBookmarkClick"
                                        Label="标记"
                                        ToolTip.Tip="标记当前帧（F6）">
                                        <CommandBarButton.Icon>
                                            <icons:SymbolIcon Symbol="BookmarkAdd" />
                                        </CommandBarButton.Icon>
                                    </CommandBarButton>
                                    <CommandBarButton Click="ReturnBookmarkClick" Label="返回">
                                        <CommandBarButton.Icon>
                                            <icons:SymbolIcon Symbol="ArrowUndo" />
                                        </CommandBarButton.Icon>
                                    </CommandBarButton>
                                </CommandBar.PrimaryCommands>
                                <CommandBar.SecondaryCommands>
                                    <CommandBarButton Click="RemoveBookmarkClick" Label="删除书签">
                                        <CommandBarButton.Icon>
                                            <icons:SymbolIcon Symbol="Delete" />
                                        </CommandBarButton.Icon>
                                    </CommandBarButton>
                                </CommandBar.SecondaryCommands>
                            </CommandBar>
                            <ListBox
                                x:Name="BookmarkList"
                                MinHeight="75"
                                MaxHeight="180" />
                            <TextBlock
                                FontSize="12"
                                Foreground="#A6B5C8"
                                Text="书签高亮显示在时间轴；返回自动定位，随后可直接录制覆盖。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Expander Header="批量编辑">
                        <Border
                            Padding="14"
                            Background="#192332"
                            CornerRadius="8">
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Foreground="#E9BA71"
                                    Text="修改后使用时间轴上方的“应用到录制”，或直接 Ctrl+S 应用并保存。"
                                    TextWrapping="Wrap" />
                                <TextBlock Foreground="#A6B5C8" Text="插入 / 追加数量" />
                                <NumericUpDown
                                    x:Name="InsertCount"
                                    FormatString="0"
                                    Maximum="1000000"
                                    Minimum="1"
                                    Value="1" />
                                <TextBlock Foreground="#A6B5C8" Text="起始帧 / 结束帧（含两端）" />
                                <NumericUpDown
                                    x:Name="RangeStart"
                                    FormatString="0"
                                    Maximum="0"
                                    Minimum="0"
                                    Value="0" />
                                <NumericUpDown
                                    x:Name="RangeEnd"
                                    FormatString="0"
                                    Maximum="0"
                                    Minimum="0"
                                    Value="0" />
                                <ComboBox
                                    x:Name="ActionPicker"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="4" />
                                <Button
                                    x:Name="HoldButton"
                                    Click="HoldClick"
                                    Content="整个区间按住"
                                    IsEnabled="False" />
                                <Button
                                    x:Name="ReleaseButton"
                                    Click="ReleaseClick"
                                    Content="整个区间松开"
                                    IsEnabled="False" />
                                <CommandBar DefaultLabelPosition="Right">
                                    <CommandBar.SecondaryCommands>
                                        <CommandBarButton Click="InsertFramesClick" Label="在选中帧前插入空白帧">
                                            <CommandBarButton.Icon>
                                                <icons:SymbolIcon Symbol="DocumentAdd" />
                                            </CommandBarButton.Icon>
                                        </CommandBarButton>
                                        <CommandBarButton Click="AppendFramesClick" Label="在末尾追加空白帧">
                                            <CommandBarButton.Icon>
                                                <icons:SymbolIcon Symbol="ArrowRight" />
                                            </CommandBarButton.Icon>
                                        </CommandBarButton>
                                        <CommandBarButton Click="DeleteFramesClick" Label="删除起止区间的帧">
                                            <CommandBarButton.Icon>
                                                <icons:SymbolIcon Symbol="Delete" />
                                            </CommandBarButton.Icon>
                                        </CommandBarButton>
                                    </CommandBar.SecondaryCommands>
                                </CommandBar>
                            </StackPanel>
                        </Border>
                    </Expander>
                    <TextBlock
                        x:Name="ValidationLabel"
                        FontSize="12"
                        Foreground="#D0C4AE"
                        Text="时间轴黄色标记表示待应用；Ctrl+S 会应用并保存 .krec。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <Border
            Grid.Row="2"
            Padding="20,10"
            Background="#171F2D">
            <StackPanel Spacing="6">
                <CommandBar
                    x:Name="VideoExportBar"
                    DefaultLabelPosition="Right"
                    IsVisible="False">
                    <CommandBar.Content>
                        <TextBlock
                            x:Name="VideoProgressLabel"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap" />
                    </CommandBar.Content>
                    <CommandBar.PrimaryCommands>
                        <CommandBarButton
                            x:Name="CancelVideoExportButton"
                            Click="CancelVideoExportClick"
                            IsVisible="False"
                            Label="取消导出">
                            <CommandBarButton.Icon>
                                <icons:SymbolIcon Symbol="Dismiss" />
                            </CommandBarButton.Icon>
                        </CommandBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        x:Name="SavedPathLabel"
                        VerticalAlignment="Center"
                        Foreground="#77DBC7"
                        Text="保存位置：尚未保存；点击顶部“保存录制…”选择目录"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="OpenSavedButton"
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        Click="OpenSavedClick"
                        Content="打开保存目录"
                        IsEnabled="False" />
                </Grid>
                <TextBlock
                    x:Name="StatusLabel"
                    Foreground="#A6B5C8"
                    Text="F9 播放/暂停 · F10 逐帧 · F8 录制 · F6 书签 · F5 应用修改 · Esc 取消定位 · Ctrl+S 保存"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
