<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:icons="using:FluentIcons.Avalonia" xmlns:local="using:KinokoTAS.App" x:Class="KinokoTAS.App.MainWindow" Title="6kinoko TAS" Icon="/Assets/6kinoko.ico" Width="1500" Height="1050" MinWidth="1000" MinHeight="720" Background="#10151F">
<Grid RowDefinitions="Auto,*,Auto">
 <Border Padding="20,14" Background="#171F2D"><StackPanel Spacing="8">
<CommandBar DefaultLabelPosition="Right" x:Name="FileCommands"><CommandBar.Content><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock x:Name="GamePathLabel" MaxWidth="500" TextTrimming="CharacterEllipsis" Foreground="#A6B5C8" FontSize="12" VerticalAlignment="Center"/></StackPanel></CommandBar.Content><CommandBar.PrimaryCommands><CommandBarButton Label="新建录制" Click="NewRecordingClick" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="DocumentAdd"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="打开录制" Click="OpenClick" ToolTip.Tip="打开录制（Ctrl+O）" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="FolderOpen"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="保存录制" Click="SaveRecordingClick" ToolTip.Tip="保存录制（Ctrl+S）" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="Save"/></CommandBarButton.Icon></CommandBarButton></CommandBar.PrimaryCommands><CommandBar.SecondaryCommands><CommandBarButton Label="另存为录制…" Click="SaveRecordingAsClick" ToolTip.Tip="另存为录制（Ctrl+Shift+S）"><CommandBarButton.Icon><icons:SymbolIcon Symbol="Save"/></CommandBarButton.Icon></CommandBarButton><CommandBarToggleButton x:Name="EmbeddedOption" Label="内嵌预览" IsChecked="False"><CommandBarToggleButton.Icon><icons:SymbolIcon Symbol="Window"/></CommandBarToggleButton.Icon></CommandBarToggleButton><CommandBarButton Label="更换游戏程序…" Click="ChangeGameClick" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="Settings"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="另存输入草稿项目…" Click="SaveClick" x:Name="SaveButton" IsEnabled="False"><CommandBarButton.Icon><icons:SymbolIcon Symbol="DocumentSave"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="仅导出原始录制…" Click="ExportClick" x:Name="ExportButton" IsEnabled="False"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowExport"/></CommandBarButton.Icon></CommandBarButton></CommandBar.SecondaryCommands></CommandBar> </StackPanel></Border>
 <Grid Grid.Row="1" RowDefinitions="2*,6,3*" ColumnDefinitions="*,300" Margin="20,12" ColumnSpacing="16">
  <Border Background="#070B10" CornerRadius="8" Margin="0,0,0,8"><Grid RowDefinitions="Auto,*,Auto">
<CommandBar DefaultLabelPosition="Right" Margin="8"><CommandBar.Content><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock x:Name="EngineLabel" Text="播放控制 · 尚未开始" Foreground="#E9BA71" VerticalAlignment="Center"/><ComboBox x:Name="SpeedPicker" Width="88" SelectedIndex="2" SelectionChanged="SpeedChanged" ToolTip.Tip="播放 / 录制速度"><ComboBoxItem Content="0.25×"/><ComboBoxItem Content="0.5×"/><ComboBoxItem Content="1×"/><ComboBoxItem Content="2×"/><ComboBoxItem Content="4×"/></ComboBox></StackPanel></CommandBar.Content><CommandBar.PrimaryCommands><CommandBarButton x:Name="PlayGameButton" Label="播放" Click="PlayGameClick" ToolTip.Tip="播放 / 暂停（F9）" IsEnabled="False" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="Play"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton x:Name="PauseGameButton" Label="暂停" Click="PauseGameClick" ToolTip.Tip="播放 / 暂停（F9）" IsVisible="False" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="Pause"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="前进一帧" Click="StepGameClick" ToolTip.Tip="前进一帧（F10）" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="Next"/></CommandBarButton.Icon></CommandBarButton><CommandBarToggleButton x:Name="RecordToggle" Label="录制" Click="TakeoverClick" ToolTip.Tip="切换录制（F8）" ><CommandBarToggleButton.Icon><icons:SymbolIcon Symbol="Record"/></CommandBarToggleButton.Icon></CommandBarToggleButton><CommandBarButton x:Name="RestartGameButton" Label="重新启动游戏" Click="RestartGameClick" IsEnabled="False"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowSync"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="从头重播" Click="ReplayAllClick"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowCounterclockwise"/></CommandBarButton.Icon></CommandBarButton><CommandBarToggleButton x:Name="FollowLatest" Label="跟随最新帧" IsChecked="True"><CommandBarToggleButton.Icon><icons:SymbolIcon Symbol="ArrowRight"/></CommandBarToggleButton.Icon></CommandBarToggleButton></CommandBar.PrimaryCommands><CommandBar.SecondaryCommands><CommandBarButton x:Name="RestoreOverwriteButton" Label="恢复上次覆盖" Click="RestoreOverwriteClick" IsEnabled="False" ToolTip.Tip="Ctrl+Shift+Z"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowUndo"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton x:Name="CancelOperationButton" Label="取消定位 / 模拟" Click="CancelOperationClick" IsEnabled="False" ToolTip.Tip="Esc"><CommandBarButton.Icon><icons:SymbolIcon Symbol="Dismiss"/></CommandBarButton.Icon></CommandBarButton></CommandBar.SecondaryCommands></CommandBar>
   <Border x:Name="GamePanel" Grid.Row="1" Focusable="True" KeyDown="GameKeyDown" KeyUp="GameKeyUp" LostFocus="GameLostFocus" PointerPressed="GamePointerPressed"><Grid><TextBlock x:Name="ExternalHint" Text="游戏将在独立窗口显示&#10;&#10;从顶部新建或打开录制&#10;F9 播放 / 暂停 · F10 前进一帧" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A6B5C8" FontSize="18" TextAlignment="Center"/><Image x:Name="GameImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/></Grid></Border>
   <TextBlock x:Name="GameStatus" Grid.Row="2" Margin="10,6" Foreground="#A6B5C8" Text="准备就绪。首次开始时选择游戏程序，之后自动使用。" TextWrapping="Wrap"/>
  </Grid></Border>
  <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#2C3749" ResizeDirection="Rows"/>
  <Border Grid.Row="2" Background="#151D29" CornerRadius="8"><Grid RowDefinitions="Auto,*,Auto">
   <TextBlock x:Name="DocumentLabel" Margin="12,10" Text="时间轴 · 尚未打开录制" Foreground="#BBC7D8"/>
   <Grid Grid.Row="1" RowDefinitions="*,16"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><local:TimelineControl x:Name="Timeline" Height="346" HorizontalAlignment="Stretch" VerticalAlignment="Top"/></ScrollViewer><ScrollBar x:Name="FrameScroll" Grid.Row="1" Orientation="Horizontal" ValueChanged="ScrollChanged"/></Grid>
   <WrapPanel Grid.Row="2" Margin="12"><TextBlock Text="定位帧" VerticalAlignment="Center" Foreground="#A6B5C8" Margin="0,0,12,0"/><Button Content="上一帧" Click="PreviousClick" Margin="0,0,6,0"/><Button Content="下一帧" Click="NextClick" Margin="0,0,6,0"/><NumericUpDown x:Name="JumpFrame" Width="135" Minimum="0" Maximum="0" FormatString="0" Value="0" Margin="0,0,6,0"/><Button Content="跳到此帧" Click="JumpClick"/></WrapPanel>
  </Grid></Border>
  <ScrollViewer Grid.Column="1" Grid.RowSpan="3"><StackPanel Spacing="12">
   <Border Background="#192332" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="帧工具" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FrameLabel" Text="—" FontSize="30"/><TextBlock x:Name="FrameDetails" Text="尚未载入录制" TextWrapping="Wrap" Foreground="#A6B5C8" FontSize="12"/>
    <TextBlock Text="书签 / 重点" FontSize="16" Margin="0,8,0,0"/><TextBox x:Name="BookmarkName" PlaceholderText="名称，例如：Boss 前"/><CommandBar DefaultLabelPosition="Right" ><CommandBar.PrimaryCommands><CommandBarButton Label="标记" Click="AddBookmarkClick" ToolTip.Tip="标记当前帧（F6）" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="BookmarkAdd"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="返回" Click="ReturnBookmarkClick" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowUndo"/></CommandBarButton.Icon></CommandBarButton></CommandBar.PrimaryCommands><CommandBar.SecondaryCommands><CommandBarButton Label="删除书签" Click="RemoveBookmarkClick" ><CommandBarButton.Icon><icons:SymbolIcon Symbol="Delete"/></CommandBarButton.Icon></CommandBarButton></CommandBar.SecondaryCommands></CommandBar><ListBox x:Name="BookmarkList" MinHeight="75" MaxHeight="180"/><TextBlock Text="书签高亮显示在时间轴；返回自动定位，随后可直接录制覆盖。" TextWrapping="Wrap" Foreground="#A6B5C8" FontSize="12"/>
   </StackPanel></Border>
   <Expander Header="编辑帧输入"><Border Background="#192332" CornerRadius="8" Padding="14"><StackPanel Spacing="10"><TextBlock Text="修改按键后应用并验证；验证成功才替换当前录制。" TextWrapping="Wrap" Foreground="#E9BA71"/><CommandBar DefaultLabelPosition="Right" ><CommandBar.PrimaryCommands><CommandBarButton x:Name="ApplyEditsButton" Label="应用修改" Click="ApplyEditsClick" ToolTip.Tip="重新模拟并验证（F5）" IsEnabled="False"><CommandBarButton.Icon><icons:SymbolIcon Symbol="Play"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="撤销" Click="UndoClick" ToolTip.Tip="撤销输入编辑（Ctrl+Z）" x:Name="UndoButton" IsEnabled="False"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowUndo"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="重做" Click="RedoClick" ToolTip.Tip="重做输入编辑（Ctrl+Y）" x:Name="RedoButton" IsEnabled="False"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowRedo"/></CommandBarButton.Icon></CommandBarButton></CommandBar.PrimaryCommands><CommandBar.SecondaryCommands><CommandBarButton Label="在选中帧前插入空白帧" Click="InsertFramesClick"><CommandBarButton.Icon><icons:SymbolIcon Symbol="DocumentAdd"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="在末尾追加空白帧" Click="AppendFramesClick"><CommandBarButton.Icon><icons:SymbolIcon Symbol="ArrowRight"/></CommandBarButton.Icon></CommandBarButton><CommandBarButton Label="删除起止区间的帧" Click="DeleteFramesClick"><CommandBarButton.Icon><icons:SymbolIcon Symbol="Delete"/></CommandBarButton.Icon></CommandBarButton></CommandBar.SecondaryCommands></CommandBar><TextBlock Text="插入数量（帧编辑菜单 …）" Foreground="#A6B5C8"/><NumericUpDown x:Name="InsertCount" Minimum="1" Maximum="1000000" Value="1" FormatString="0"/><TextBlock Text="起始帧 / 结束帧（含两端）" Foreground="#A6B5C8"/><NumericUpDown x:Name="RangeStart" Minimum="0" Maximum="0" Value="0" FormatString="0"/><NumericUpDown x:Name="RangeEnd" Minimum="0" Maximum="0" Value="0" FormatString="0"/><ComboBox x:Name="ActionPicker" HorizontalAlignment="Stretch" SelectedIndex="4"/><Button x:Name="HoldButton" Content="整个区间按住" Click="HoldClick" IsEnabled="False"/><Button x:Name="ReleaseButton" Content="整个区间松开" Click="ReleaseClick" IsEnabled="False"/></StackPanel></Border></Expander>
   <TextBlock x:Name="ValidationLabel" Text="修改输入 → 应用修改 → 回放验证 → 保存录制。" TextWrapping="Wrap" Foreground="#D0C4AE" FontSize="12"/>
  </StackPanel></ScrollViewer>
 </Grid>
 <Border Grid.Row="2" Background="#171F2D" Padding="20,10"><StackPanel Spacing="6"><Grid ColumnDefinitions="*,Auto"><TextBlock x:Name="SavedPathLabel" Text="保存位置：尚未保存；点击顶部“保存录制…”选择目录" Foreground="#77DBC7" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="OpenSavedButton" Grid.Column="1" Content="打开保存目录" Click="OpenSavedClick" IsEnabled="False" Margin="12,0,0,0"/></Grid><TextBlock x:Name="StatusLabel" Text="F9 播放/暂停 · F10 逐帧 · F8 录制 · F6 书签 · F5 应用修改 · Esc 取消定位 · Ctrl+S 保存" Foreground="#A6B5C8" TextWrapping="Wrap"/></StackPanel></Border>
</Grid></Window>
