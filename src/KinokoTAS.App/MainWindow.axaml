<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:KinokoTAS.App" x:Class="KinokoTAS.App.MainWindow" Title="Kinoko TAS" Width="1500" Height="1050" MinWidth="1000" MinHeight="640" Background="#10151F">
<Grid RowDefinitions="Auto,Auto,*,Auto">
 <Border Padding="24,18" Background="#171F2D"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="KINOKO / TAS" FontSize="23" FontWeight="Bold" Foreground="#77DBC7"/><TextBlock Text="输入时间轴工作台" Foreground="#A3B2C7" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button Content="打开录制" Click="OpenClick"/><Button x:Name="SaveButton" Content="另存项目" Click="SaveClick" IsEnabled="False"/><Button x:Name="ExportButton" Content="导出原始录制" Click="ExportClick" IsEnabled="False"/></StackPanel></Grid></Border>
 <Border Grid.Row="1" Padding="24,12" BorderBrush="#2C3749" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="UndoButton" Content="撤销" Click="UndoClick" IsEnabled="False"/><Button x:Name="RedoButton" Content="重做" Click="RedoClick" IsEnabled="False"/><TextBlock x:Name="DocumentLabel" Text="打开 .krec 录制开始编辑" VerticalAlignment="Center" Foreground="#BBC7D8"/></StackPanel><TextBlock Grid.Column="1" x:Name="EngineLabel" Text="游戏未连接" Foreground="#E9BA71" VerticalAlignment="Center"/></Grid></Border>
 <Grid Grid.Row="2" RowDefinitions="3*,6,2*" ColumnDefinitions="*,285" Margin="20,16" ColumnSpacing="16">
  <Border Margin="0,0,0,12" Background="#070B10" CornerRadius="8"><Grid RowDefinitions="Auto,*,Auto">
   <StackPanel Orientation="Horizontal" Spacing="6" Margin="8"><Button Content="新建录制" Click="NewRecordingClick"/><Button Content="更换游戏程序" Click="ChangeGameClick"/><CheckBox x:Name="EmbeddedOption" Content="内嵌预览" IsChecked="False"/><Button Content="播放" Click="PlayGameClick"/><Button Content="暂停" Click="PauseGameClick"/><Button Content="前进一帧" Click="StepGameClick"/><Button Content="从这里继续录制" Click="TakeoverClick"/><Button Content="结束录制并保存" Click="StopGameClick"/></StackPanel>
   <Border x:Name="GamePanel" Grid.Row="1" Focusable="True" KeyDown="GameKeyDown" KeyUp="GameKeyUp" LostFocus="GameLostFocus" PointerPressed="GamePointerPressed"><Grid><TextBlock x:Name="ExternalHint" Text="游戏将在独立窗口显示&#10;&#10;新建录制：从头开始玩并记录操作&#10;打开录制：观看已有录制，也可从任意帧继续录制&#10;&#10;游戏窗口快捷键：F9 播放 / 暂停 · F10 前进一帧" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A6B5C8" FontSize="18" TextAlignment="Center"/><Image x:Name="GameImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None"/></Grid></Border>
   <TextBlock x:Name="GameStatus" Grid.Row="2" Margin="10,4" Foreground="#A6B5C8" Text="点击“新建录制”或“打开录制”开始；首次需选择配套游戏程序。" TextWrapping="Wrap"/>
  </Grid></Border>
  <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="#2C3749" ResizeDirection="Rows"/>
  <Border Grid.Row="2" Background="#151D29" CornerRadius="8" BorderBrush="#2C3749" BorderThickness="1"><Grid RowDefinitions="Auto,*,Auto"><TextBlock Margin="16,12" Text="输入时间轴  ·  点击动作切换按下 / 松开，滚轮浏览" Foreground="#B4C4D8"/>
   <Grid Grid.Row="1" ColumnDefinitions="*,18"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><local:TimelineControl x:Name="Timeline" Width="1315" VerticalAlignment="Stretch"/></ScrollViewer><ScrollBar x:Name="FrameScroll" Grid.Column="1" Orientation="Vertical" ValueChanged="ScrollChanged"/></Grid>
   <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="12"><Button Content="上一帧" Click="PreviousClick"/><Button Content="下一帧" Click="NextClick"/><NumericUpDown x:Name="JumpFrame" Width="135" Minimum="0" Maximum="0" FormatString="0" Value="0"/><Button Content="定位" Click="JumpClick"/><TextBlock Text="未连接时移动光标；连接后定位画面" VerticalAlignment="Center" Foreground="#8C9FB8"/></StackPanel>
  </Grid></Border>
  <ScrollViewer Grid.Column="1" Grid.RowSpan="3"><StackPanel Spacing="14">
   <Border Background="#192332" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="当前帧" FontSize="14" Foreground="#99ABC2"/><TextBlock x:Name="FrameLabel" Text="—" FontSize="32" FontWeight="Bold"/><TextBlock x:Name="FrameDetails" Text="尚未载入录制" TextWrapping="Wrap" Foreground="#B4C4D8" FontSize="12"/></StackPanel></Border>
   <Border Background="#192332" CornerRadius="8" Padding="16"><StackPanel Spacing="10"><TextBlock Text="输入草稿（不影响回放）" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="起始帧 / 结束帧（包含两端）" Foreground="#A6B5C8" FontSize="12"/><NumericUpDown x:Name="RangeStart" Minimum="0" Maximum="0" Value="0" FormatString="0"/><NumericUpDown x:Name="RangeEnd" Minimum="0" Maximum="0" Value="0" FormatString="0"/><ComboBox x:Name="ActionPicker" HorizontalAlignment="Stretch" SelectedIndex="4"/><Button x:Name="HoldButton" Content="整个区间按住" Click="HoldClick" HorizontalAlignment="Stretch" IsEnabled="False"/><Button x:Name="ReleaseButton" Content="整个区间松开" Click="ReleaseClick" HorizontalAlignment="Stretch" IsEnabled="False"/></StackPanel></Border>
   <Border Background="#28251E" CornerRadius="8" Padding="16"><StackPanel Spacing="8"><TextBlock Text="验证状态" Foreground="#E9BA71" FontWeight="SemiBold"/><TextBlock x:Name="ValidationLabel" Text="编辑结果保存为 .ktas 项目。输入草稿暂不支持重新模拟；继续录制请用“从这里继续录制”。" TextWrapping="Wrap" Foreground="#D0C4AE" FontSize="12"/></StackPanel></Border>
  </StackPanel></ScrollViewer>
 </Grid>
 <Border Grid.Row="3" Background="#171F2D" Padding="24,10"><TextBlock x:Name="StatusLabel" Text="就绪 · Ctrl+O 打开 · Ctrl+S 另存 · Ctrl+Z / Ctrl+Y 撤销重做" Foreground="#A6B5C8" TextWrapping="Wrap"/></Border>
</Grid></Window>